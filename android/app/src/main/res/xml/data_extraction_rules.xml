<?xml version="1.0" encoding="utf-8"?>
<!-- Secure storage holds the YouTube session, and the sign-in web view keeps
     its cookies under app_webview: never back up or transfer either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="root" path="app_webview"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="root" path="app_webview"/>
    </device-transfer>
</data-extraction-rules>
