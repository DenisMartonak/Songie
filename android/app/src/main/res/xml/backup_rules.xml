<?xml version="1.0" encoding="utf-8"?>
<!-- Secure storage holds the YouTube session, and the sign-in web view keeps
     its cookies under app_webview: never back either up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="root" path="app_webview"/>
</full-backup-content>
